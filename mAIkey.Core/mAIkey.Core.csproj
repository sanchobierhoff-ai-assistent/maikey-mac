<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>mAIkey.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Shared/ is 1-op-1 overgenomen uit de Windows-app (frontend/Services); die code
         gebruikt nog verouderde velden voor backward-compat met oude configs. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <!-- Zelfde (cross-platform) pakketten als de Windows-app -->
  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.3.0" />
    <PackageReference Include="MsgReader" Version="5.3.1" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>
</Project>
