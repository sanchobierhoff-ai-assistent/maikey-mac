<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:loc="using:mAIkey.Desktop"
        x:Class="mAIkey.Desktop.MainWindow"
        Title="mAIkey"
        Width="1280" Height="720"
        MinWidth="1100" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource Bg0}">

  <!-- Native macOS-chrome: het besturingssysteem tekent frame, schaduw,
       afgeronde hoeken en de stoplicht-knoppen (linksboven). -->
  <Border Background="{DynamicResource Bg0}">
    <Grid Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ═══ SIDEBAR ═══ -->
      <Border Grid.Column="0" Background="{DynamicResource Bg0}"
              BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,1,0">
        <DockPanel>

          <!-- Logo + titelbalk-sleepgebied (linkermarge houdt de macOS-stoplichten vrij) -->
          <Border DockPanel.Dock="Top" Height="40" Margin="76,0,0,0"
                  IsHitTestVisible="True" Name="TitleBarArea" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image Source="avares://mAIkey.Desktop/Resources/maikey-128.png" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
              <Run Text="m" Foreground="{DynamicResource Text1}" />
              <Run Text="AI" Foreground="{DynamicResource Accent}" FontWeight="Bold" />
              <Run Text="key" Foreground="{DynamicResource Text1}" />
            </TextBlock>
            </StackPanel>
          </Border>

          <!-- Profiel + uitloggen onderaan -->
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12">
            <Separator Margin="12,0,12,8" />

            <Button Name="ProfileBtn" Classes="NavButton" Height="44" Click="NavProfile_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                      <GradientStop Color="#F5A524" Offset="0" />
                      <GradientStop Color="#C27F0E" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <i:Icon Value="mdi-account" FontSize="14" Foreground="#0B0B0D"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Name="UserEmailText" loc:Tr.Key="Nav_Profile" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text1}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Button>

            <Button Name="LogoutBtn" Classes="NavLogoutButton" Height="36" Click="Logout_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-logout" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Logout" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Nav-knoppen -->
          <StackPanel Margin="0,12,0,0" Spacing="2">
            <Button Name="NavDashboard" Classes="NavButton active" Height="36" Click="NavDashboard_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-view-dashboard" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Dashboard" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>

            <Button Name="NavHotkeys" Classes="NavButton" Height="36" Click="NavHotkeys_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-lightning-bolt" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Hotkeys" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>

            <Button Name="NavStyles" Classes="NavButton" Height="36" Click="NavStyles_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-book-open-variant" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_StyleLibrary" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>

            <Button Name="NavTemplates" Classes="NavButton" Height="36" Click="NavTemplates_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-file-document-edit" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Templates" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>

            <Button Name="NavIntegrations" Classes="NavButton" Height="36" Click="NavIntegrations_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-connection" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Integrations" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>

            <Button Name="NavKoppelingen" Classes="NavButton" Height="36" Click="NavKoppelingen_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-link-variant" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Koppelingen" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
                <Border Name="InboxBadge" IsVisible="False" VerticalAlignment="Center"
                        Background="{DynamicResource Accent}" CornerRadius="9" Height="18" MinWidth="18" Padding="5,0">
                  <TextBlock Name="InboxBadgeText" Text="0" Foreground="White" FontSize="10.5" FontWeight="Bold"
                             VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
              </StackPanel>
            </Button>

            <Button Name="NavCloudSync" Classes="NavButton" Height="36" Click="NavCloudSync_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-cloud-sync-outline" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_CloudSync" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>

            <Button Name="NavSettings" Classes="NavButton" Height="36" Click="NavSettings_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <i:Icon Value="mdi-cog" FontSize="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Settings" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>

            <Button Name="NavAssistant" Classes="NavButton" Height="36" Click="NavAssistant_Click">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Source="avares://mAIkey.Desktop/Resources/maikey-loading-mark.png" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock loc:Tr.Key="Nav_Assistant" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ═══ CONTENT ═══ -->
      <Border Grid.Column="1" Background="{DynamicResource Bg1}">
        <DockPanel>
          <!-- Titelbalk-sleepgebied (native macOS-knoppen zitten linksboven) -->
          <Border DockPanel.Dock="Top" Height="40" Name="ContentTitleBar"
                  Background="Transparent" IsHitTestVisible="True" />

          <ContentControl Name="ContentArea" Margin="0" />
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
