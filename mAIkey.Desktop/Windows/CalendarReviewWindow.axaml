<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:mAIkey.Desktop"
        x:Class="mAIkey.Desktop.Windows.CalendarReviewWindow"
        Title="Agenda-afspraak nakijken"
        Width="560" Height="640"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{DynamicResource Bg1}">

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Classes="eyebrow" Text="GOOGLE AGENDA"/>
      <TextBlock Classes="title" loc:Tr.Key="CalReview_Title" FontSize="22"/>
      <TextBlock Classes="subtitle" FontSize="13" loc:Tr.Key="CalReview_Subtitle"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
      <Button Name="CreateBtn" Classes="accent" loc:Tr.Key="CalReview_CreateBtn" Click="Create_Click"/>
      <Button Classes="ghost" loc:Tr.Key="Common_Cancel" Click="Cancel_Click"/>
      <TextBlock Name="StatusText" Classes="muted" IsVisible="False"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Spacing="12">
      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="CalReview_EventTitle" Classes="muted"/>
        <TextBox Name="TitleBox"/>
      </StackPanel>
      <Grid ColumnDefinitions="*,12,*">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock loc:Tr.Key="CalReview_Start" Classes="muted"/>
          <TextBox Name="StartBox"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock loc:Tr.Key="CalReview_End" Classes="muted"/>
          <TextBox Name="EndBox"/>
        </StackPanel>
      </Grid>
      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="CalReview_Location" Classes="muted"/>
        <TextBox Name="LocationBox"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="CalReview_Attendees" Classes="muted"/>
        <TextBox Name="AttendeesBox"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="CalReview_Description" Classes="muted"/>
        <TextBox Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="120" VerticalContentAlignment="Top"/>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
