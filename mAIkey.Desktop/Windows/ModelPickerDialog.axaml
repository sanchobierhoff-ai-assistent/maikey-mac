<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mAIkey.Desktop.Windows.ModelPickerDialog"
        Title="mAIkey"
        Width="528" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False">

  <Border Name="Shell" Margin="24" CornerRadius="14" BorderThickness="1"
          BorderBrush="{DynamicResource Border1}" Background="{DynamicResource Bg1}"
          BoxShadow="0 8 28 0 #8C000000">
    <StackPanel Margin="28">
      <StackPanel Name="Header" Margin="0,0,0,18" Background="Transparent">
        <TextBlock Name="HeaderLabel" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text3}" Margin="0,0,0,6" Opacity="0.8"/>
        <TextBlock Name="SubtitleBlock" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text1}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Name="BodyLabel" FontSize="12.5" Foreground="{DynamicResource Text3}" TextWrapping="Wrap"/>
      </StackPanel>

      <ComboBox Name="ModelComboBox" Height="38" HorizontalAlignment="Stretch" Classes="MkComboBox">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Name="CancelButton" Height="38" Padding="18,0" Margin="0,0,8,0"
                VerticalContentAlignment="Center" Click="Cancel_Click" Classes="GhostButton"/>
        <Button Name="RetryButton" Height="38" Padding="22,0"
                VerticalContentAlignment="Center" Click="Retry_Click" Classes="AccentButton"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
