<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:mAIkey.Desktop"
        x:Class="mAIkey.Desktop.Windows.IntegrationReviewWindow"
        Title="Nakijken"
        Width="560" Height="600"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{DynamicResource Bg1}">

  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Name="Eyebrow" Classes="eyebrow" loc:Tr.Key="Dlg_IntegrationEyebrow"/>
      <TextBlock Name="Heading" Classes="title" loc:Tr.Key="Dlg_Review" FontSize="22"/>
      <TextBlock Classes="subtitle" FontSize="13" loc:Tr.Key="Dlg_ReviewSub"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
      <Button Name="CreateBtn" Classes="accent" loc:Tr.Key="Dlg_Send" Click="Create_Click"/>
      <Button Classes="ghost" loc:Tr.Key="Common_Cancel" Click="Cancel_Click"/>
      <TextBlock Name="StatusText" Classes="muted" IsVisible="False"
                 VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Spacing="12">
      <StackPanel Name="TitleSection" Spacing="6">
        <TextBlock Name="TitleLabel" loc:Tr.Key="Dlg_Title" Classes="muted"/>
        <TextBox Name="TitleBox"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="Dlg_Content" Classes="muted"/>
        <TextBox Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="300" VerticalContentAlignment="Top"/>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>