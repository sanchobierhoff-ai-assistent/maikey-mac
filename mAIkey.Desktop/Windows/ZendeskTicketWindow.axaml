<Window x:Class="mAIkey.Desktop.Windows.ZendeskTicketWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zendesk-tickets" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg1}"
        FontFamily="{DynamicResource FontUi}">


    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Links: zoeken + resultaten -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Zendesk-tickets" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Text1}" Margin="0,0,0,10"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="32" VerticalContentAlignment="Center"
                         Classes="MkTextBox" KeyDown="SearchBox_KeyDown"/>
                <Button Grid.Column="1" Content="Zoek" Width="60" Height="32" Margin="8,0,0,0"
                        Classes="GhostButton" Click="Search_Click"/>
            </Grid>
            <ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged"
                     BorderBrush="{DynamicResource Border1}" Background="{DynamicResource Bg2}"
                     Foreground="{DynamicResource Text1}"/>
        </DockPanel>

        <!-- Rechts: detail + bewerken -->
        <Border Grid.Column="1" Background="{DynamicResource Bg2}" CornerRadius="10"
                BorderBrush="{DynamicResource Border1}" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" IsEnabled="False">
                    <TextBlock x:Name="SubjectText" Text="Kies een ticket" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Text1}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Status" FontSize="12" Foreground="{DynamicResource Text3}"/>
                            <ComboBox x:Name="StatusCombo" Height="30" Margin="0,4,0,0" Classes="MkComboBox">
                                <ComboBoxItem Content="new"/>
                                <ComboBoxItem Content="open"/>
                                <ComboBoxItem Content="pending"/>
                                <ComboBoxItem Content="hold"/>
                                <ComboBoxItem Content="solved"/>
                                <ComboBoxItem Content="closed"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Prioriteit" FontSize="12" Foreground="{DynamicResource Text3}"/>
                            <ComboBox x:Name="PriorityCombo" Height="30" Margin="0,4,0,0" Classes="MkComboBox">
                                <ComboBoxItem Content="low"/>
                                <ComboBoxItem Content="normal"/>
                                <ComboBoxItem Content="high"/>
                                <ComboBoxItem Content="urgent"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Tags (kommagescheiden)" FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,12,0,4"/>
                    <TextBox x:Name="TagsBox" Height="30" VerticalContentAlignment="Center" Classes="MkTextBox"/>

                    <TextBlock Text="Verloop / reacties" FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,12,0,4"/>
                    <TextBox x:Name="CommentsBox" Height="180" IsReadOnly="True" TextWrapping="Wrap"
                             Classes="MkTextBox"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{DynamicResource Bg3}"/>

                    <TextBlock Text="Reactie plaatsen" FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,12,0,4"/>
                    <TextBox x:Name="ReplyBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                             Classes="MkTextBox"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <CheckBox x:Name="PublicCheck" Content="Publiek (zichtbaar voor de klant)" IsChecked="True"
                              Foreground="{DynamicResource Text2}" Margin="0,6,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="SaveButton" Content="Opslaan" Width="120" Height="34"
                                Classes="AccentButton" Click="Save_Click"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Text3}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
