<Window x:Class="mAIkey.Desktop.Windows.ForgotPasswordWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wachtwoord vergeten"
        Height="540"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" TransparencyLevelHint="Transparent" SystemDecorations="None" CanResize="False">

    <Border BorderBrush="{DynamicResource Border1}" BorderThickness="1" CornerRadius="14"
            Background="{DynamicResource Bg1}">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="Transparent"
                    CornerRadius="14,14,0,0"
                    PointerPressed="TitleBar_MouseLeftButtonDown">
                <Grid Height="40">
                    <TextBlock Text="Wachtwoord vergeten"
                               Foreground="{DynamicResource Text2}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="20,0"/>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="40" Height="40"
                            Background="Transparent"
                            Foreground="{DynamicResource Text3}"
                            BorderThickness="0"
                            FontSize="14"
                            Click="CloseButton_Click"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="36,12,36,28">

                <!-- STAP 1: E-mail invoeren -->
                <StackPanel x:Name="Step1Panel">
                    <TextBlock x:Name="Step1Header"
                               Text="Wachtwoord resetten"
                               Foreground="{DynamicResource Text1}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,6"/>

                    <TextBlock x:Name="Step1Sub"
                               Text="Vul je e-mailadres in. We sturen je een 6-cijferige code om je wachtwoord te resetten."
                               Foreground="{DynamicResource Text3}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock x:Name="Step1EmailLabel"
                               Text="E-mail"
                               Foreground="{DynamicResource Text2}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="EmailTextBox"
                             KeyDown="Step1_KeyDown"/>

                    <TextBlock x:Name="Step1ErrorText"
                               Foreground="{DynamicResource Danger}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               IsVisible="False"/>

                    <Button x:Name="SendCodeButton" HorizontalAlignment="Stretch"
                            Content="Stuur reset-code"
                            Classes="AccentButton"
                            Height="42"
                            Margin="0,18,0,0"
                            Click="SendCodeButton_Click"/>

                    <Button x:Name="Step1CancelButton"
                            Content="Annuleren"
                            Classes="LinkButton"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Click="CloseButton_Click"/>
                </StackPanel>

                <!-- STAP 2: Code + nieuw wachtwoord -->
                <StackPanel x:Name="Step2Panel" IsVisible="False">
                    <TextBlock x:Name="Step2Header"
                               Text="Code ontvangen?"
                               Foreground="{DynamicResource Text1}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,6"/>

                    <TextBlock x:Name="Step2EmailLabel"
                               Foreground="{DynamicResource Text3}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock x:Name="CodeLabel"
                               Text="6-cijferige code"
                               Foreground="{DynamicResource Text2}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="CodeTextBox"
                             MaxLength="6"
                             FontSize="22"
                             FontFamily="{DynamicResource FontMono}"
                             TextAlignment="Center"
                             Height="48"
                             KeyDown="Step2_KeyDown"/>

                    <TextBlock x:Name="NewPasswordLabel"
                               Text="Nieuw wachtwoord"
                               Foreground="{DynamicResource Text2}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,14,0,6"/>
                    <TextBox PasswordChar="•" x:Name="NewPasswordBox"
                                 KeyDown="Step2_KeyDown"/>

                    <TextBlock x:Name="ConfirmPasswordLabel"
                               Text="Bevestig wachtwoord"
                               Foreground="{DynamicResource Text2}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,10,0,6"/>
                    <TextBox PasswordChar="•" x:Name="ConfirmPasswordBox"
                                 KeyDown="Step2_KeyDown"/>

                    <!-- Password requirements -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="ReqLength"    Text="• Minimaal 8 tekens"          Foreground="{DynamicResource Text3}" FontSize="11" Margin="0,2"/>
                        <TextBlock x:Name="ReqUppercase" Text="• Hoofdletter (A–Z)"         Foreground="{DynamicResource Text3}" FontSize="11" Margin="0,2"/>
                        <TextBlock x:Name="ReqLowercase" Text="• Kleine letter (a–z)"       Foreground="{DynamicResource Text3}" FontSize="11" Margin="0,2"/>
                        <TextBlock x:Name="ReqDigit"     Text="• Cijfer (0–9)"              Foreground="{DynamicResource Text3}" FontSize="11" Margin="0,2"/>
                        <TextBlock x:Name="ReqSpecial"   Text="• Speciaal teken (bijv. ! ? @ #)" Foreground="{DynamicResource Text3}" FontSize="11" Margin="0,2"/>
                    </StackPanel>

                    <TextBlock x:Name="Step2ErrorText"
                               Foreground="{DynamicResource Danger}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               IsVisible="False"/>

                    <Button x:Name="ResetButton" HorizontalAlignment="Stretch"
                            Content="Wachtwoord resetten"
                            Classes="AccentButton"
                            Height="42"
                            Margin="0,16,0,0"
                            Click="ResetButton_Click"/>

                    <Button Content="Andere e-mail proberen"
                            Classes="LinkButton"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Click="BackToStep1_Click"/>
                </StackPanel>

                <!-- STAP 3: Gelukt -->
                <StackPanel x:Name="Step3Panel" IsVisible="False"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="Step3Header"
                               Text="Wachtwoord gewijzigd"
                               Foreground="{DynamicResource Text1}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="Step3Sub"
                               Text="Je kunt nu inloggen met je nieuwe wachtwoord."
                               Foreground="{DynamicResource Text3}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>
                    <Button x:Name="ToLoginButton"
                            Content="Naar inloggen"
                            Classes="AccentButton"
                            Height="42"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Loading Overlay -->
            <Border x:Name="LoadingOverlay"
                    Grid.RowSpan="2"
                    Background="#CC0F0F12"
                    CornerRadius="14"
                    IsVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="LoadingText"
                               Text="Even geduld…"
                               Foreground="{DynamicResource Text1}"
                               FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
