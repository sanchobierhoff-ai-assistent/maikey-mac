<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mAIkey.Desktop.Windows.ForgotPasswordWindow"
        Title="mAIkey — Wachtwoord vergeten"
        Width="440" Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0}">

  <StackPanel Margin="48,40,48,32" Spacing="18" MaxWidth="340" HorizontalAlignment="Center">

    <StackPanel HorizontalAlignment="Center" Spacing="8">
      <TextBlock Text="Wachtwoord vergeten" FontSize="22" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
      <TextBlock Text="We sturen je een link om je wachtwoord te herstellen."
                 FontSize="13" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"
                 TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="E-mailadres" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text2}"/>
      <TextBox Name="EmailBox" Watermark="naam@voorbeeld.nl" FontSize="13"/>
    </StackPanel>

    <Button Name="SendBtn" Classes="accent" Content="Herstellink versturen"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
            Height="44" FontSize="14" Click="Send_Click"/>

    <TextBlock Name="StatusText" Classes="muted" IsVisible="False" TextWrapping="Wrap"
               HorizontalAlignment="Center" TextAlignment="Center"/>

    <Button Classes="ghost" Content="Terug naar inloggen" BorderThickness="0"
            HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text2}"
            Click="Cancel_Click"/>
  </StackPanel>
</Window>
