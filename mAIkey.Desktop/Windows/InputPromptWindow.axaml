<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:c="using:mAIkey.Desktop.Controls"
        x:Class="mAIkey.Desktop.Windows.InputPromptWindow"
        Title="mAIkey"
        Width="598" Height="398"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False">

  <Border Name="Shell" Margin="24" CornerRadius="14" BorderThickness="1"
          BorderBrush="{DynamicResource Border1}" Background="{DynamicResource Bg1}"
          BoxShadow="0 8 28 0 #8C000000" DragDrop.AllowDrop="True">
    <Grid Margin="28" RowDefinitions="Auto,*,Auto,Auto">
      <StackPanel Name="Header" Grid.Row="0" Margin="0,0,0,18" Background="Transparent">
        <TextBlock Name="HeaderLabel" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text3}" Margin="0,0,0,6" Opacity="0.8"/>
        <TextBlock Name="HeaderSubtitle" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text1}" Margin="0,0,0,6"/>
        <TextBlock Name="HeaderHint" FontSize="12.5" Foreground="{DynamicResource Text3}" TextWrapping="Wrap"/>
      </StackPanel>

      <TextBox Name="PromptTextBox" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalContentAlignment="Top" Background="{DynamicResource Bg2}"
               FontSize="13" Padding="14"/>

      <c:AttachmentStrip Name="AttachmentsPanel" Grid.Row="2" Margin="0,14,0,0"/>

      <Grid Grid.Row="3" Margin="0,16,0,0">
        <Button Name="AttachImageBtn" Height="38" Width="40" Padding="0" HorizontalAlignment="Left"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="AttachImage_Click" Classes="GhostButton">
          <i:Icon Value="mdi-paperclip" FontSize="16"/>
        </Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="CancelInputBtn" Height="38" Padding="18,0" Margin="0,0,8,0"
                  VerticalContentAlignment="Center" Click="Cancel_Click" Classes="GhostButton"/>
          <Button Name="SkipButton" Height="38" Padding="18,0" Margin="0,0,8,0"
                  VerticalContentAlignment="Center" Click="Skip_Click" Classes="GhostButton"/>
          <Button Name="SubmitInputBtn" Height="38" Padding="22,0"
                  VerticalContentAlignment="Center" Click="Submit_Click" Classes="AccentButton"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
