<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:mAIkey.Desktop"
        x:Class="mAIkey.Desktop.Windows.RegisterWindow"
        Title="mAIkey — Registreren"
        Width="440" Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0}">

  <ScrollViewer>
    <StackPanel Margin="48,32,48,32" Spacing="18" MaxWidth="340" HorizontalAlignment="Center">

      <StackPanel HorizontalAlignment="Center" Spacing="8">
        <TextBlock Text="Account aanmaken" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource Text1}" HorizontalAlignment="Center"/>
        <TextBlock loc:Tr.Key="Register_Subtitle"
                   FontSize="13" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
      </StackPanel>

      <Border Name="ErrorBorder" IsVisible="False"
              Background="#1FEF4444" BorderBrush="#55EF4444" BorderThickness="1"
              CornerRadius="10" Padding="12,10">
        <TextBlock Name="ErrorText" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap"/>
      </Border>

      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="Register_Name" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text2}"/>
        <TextBox Name="NameBox" Watermark="Je naam" FontSize="13"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="Register_Email" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text2}"/>
        <TextBox Name="EmailBox" Watermark="naam@voorbeeld.nl" FontSize="13"/>
      </StackPanel>
      <StackPanel Spacing="6">
        <TextBlock loc:Tr.Key="Register_Password" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource Text2}"/>
        <TextBox Name="PasswordBox" PasswordChar="●" Watermark="Minimaal 8 tekens" FontSize="13"/>
      </StackPanel>

      <Button Name="RegisterBtn" Classes="accent" loc:Tr.Key="Register_Button"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Height="44" FontSize="14" Click="Register_Click"/>

      <Button Classes="ghost" Content="Terug naar inloggen" BorderThickness="0"
              HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text2}"
              Click="Cancel_Click"/>
    </StackPanel>
  </ScrollViewer>
</Window>
