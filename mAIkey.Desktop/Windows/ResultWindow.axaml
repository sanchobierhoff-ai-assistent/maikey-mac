<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:loc="using:mAIkey.Desktop"
        x:Class="mAIkey.Desktop.Windows.ResultWindow"
        Title="mAIkey — Resultaat"
        Width="600" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0}">

  <DockPanel Margin="20">

    <!-- Kop -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                Margin="0,0,0,14" VerticalAlignment="Center">
      <Border Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource BorderStrong}"
              BorderThickness="1" CornerRadius="5" Width="28" Height="20" Padding="2">
        <TextBlock Text="AI" FontSize="10" FontWeight="ExtraBold"
                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
      </Border>
      <TextBlock loc:Tr.Key="Result_Title" FontSize="14" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Onderaan knoppen -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Classes="ghost" loc:Tr.Key="Result_Copy" Name="CopyBtn"
              Padding="16,8" FontSize="12" Click="CopyBtn_Click"/>
      <Button Classes="accent" loc:Tr.Key="Result_Use" Name="UseBtn"
              Padding="16,8" FontSize="12" Click="UseBtn_Click"/>
    </StackPanel>

    <!-- Resultaattekst -->
    <TextBox Name="ResultTextBox" AcceptsReturn="True" TextWrapping="Wrap"
             IsReadOnly="True" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border1}"
             BorderThickness="1" CornerRadius="10" Padding="16"
             FontSize="13" Foreground="{DynamicResource Text1}"/>
  </DockPanel>
</Window>
