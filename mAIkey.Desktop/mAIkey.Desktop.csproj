<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>mAIkey.Desktop</RootNamespace>
    <AssemblyName>mAIkey.Desktop</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Resources\maikey.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);CS0618;AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <!-- MaterialDesign vector icons (matcht WPF materialDesign:PackIcon Kind-namen) -->
    <PackageReference Include="Projektanker.Icons.Avalonia" Version="9.4.0" />
    <PackageReference Include="Projektanker.Icons.Avalonia.MaterialDesign" Version="9.4.0" />
    <!-- Auto-update (zelfde tool als de Windows-app) -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- Markdown-weergave (zelfde parser als de Windows-app) -->
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <!-- Ingebouwde lettertypen en afbeeldingen -->
  <ItemGroup>
    <AvaloniaResource Include="Resources\Fonts\*.ttf" />
    <AvaloniaResource Include="Resources\*.png" />
    <AvaloniaResource Include="Resources\maikey.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\mAIkey.Core\mAIkey.Core.csproj" />
  </ItemGroup>

  <!-- Lokalisatie (NL/EN/DE) — gelijk aan frontend/Resources/Localization + Mac-specifieke sleutels -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Localization\nl.txt" />
    <EmbeddedResource Include="Resources\Localization\en.txt" />
    <EmbeddedResource Include="Resources\Localization\de.txt" />
  </ItemGroup>
</Project>
