<UserControl x:Class="mAIkey.Desktop.Views.StyleLibraryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             Background="{DynamicResource Bg1}">

  <UserControl.Styles>
    <Style Selector="ListBox#StylesListView ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="Padding" Value="13,10,16,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox#StylesListView ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Bg2}"/>
    </Style>
    <Style Selector="ListBox#StylesListView ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>
  </UserControl.Styles>

    <!-- 280px + gap 16 + 1fr -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT: Stijl-lijst                                             -->
        <!-- ============================================================ -->
        <Grid Grid.Column="0"
              Background="{DynamicResource Bg0}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="20,18"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock x:Name="PageEyebrow" Text="STIJLEN"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text3}"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="PageTitle" Text="Stijlbibliotheek"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text1}"/>
                </StackPanel>
            </Border>

            <!-- List -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ListBox x:Name="StylesListView"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="StylesListView_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource Text1}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ShortDescription}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource Text3}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <Border x:Name="EmptyState" IsVisible="False"
                            Margin="16,24,16,0">
                        <StackPanel HorizontalAlignment="Center">
                            <i:Icon Value="mdi-book-open-page-variant" FontSize="36"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{DynamicResource Text3}"
                                                     Opacity="0.5"/>
                            <TextBlock x:Name="EmptyStateTitle" Text="Geen stijlen aangemaakt"
                                       FontSize="13" Foreground="{DynamicResource Text2}"
                                       HorizontalAlignment="Center" Margin="0,10,0,3"/>
                            <TextBlock x:Name="EmptyStateSub" Text="Klik op 'Nieuwe Stijl' om te beginnen"
                                       FontSize="11" Foreground="{DynamicResource Text3}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer></Border>

            <!-- Footer: Nieuwe stijl -->
            <Border Grid.Row="2" Padding="16,12"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="0,1,1,0">
                <StackPanel>
                    <Button x:Name="NewStyleBtn"
                            Content="+ Nieuwe Stijl" Height="36"
                            Click="NewStyle_Click"
                            HorizontalAlignment="Stretch"
                            Classes="AccentButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <Button x:Name="ZendeskStyleBtn" Classes="GhostButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="8,0"
                            Content="Stijl uit mijn Zendesk-antwoorden" Height="34"
                            Click="ZendeskStyle_Click"
                            HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- gap col 1 intentionally empty -->

        <!-- ============================================================ -->
        <!-- RIGHT: Inline editor                                          -->
        <!-- ============================================================ -->
        <Grid Grid.Column="2">
            <!-- Placeholder -->
            <StackPanel x:Name="RightPlaceholder"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <i:Icon Value="mdi-book-open-page-variant" FontSize="56"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Text3}"
                                         Opacity="0.35"/>
                <TextBlock x:Name="RightPlaceholderText" Text="Selecteer een stijl om te bewerken"
                           FontSize="15" Foreground="{DynamicResource Text3}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>

            <!-- Editor -->
            <ContentControl x:Name="StyleEditorContainer"/>
        </Grid>

    </Grid>
</UserControl>
