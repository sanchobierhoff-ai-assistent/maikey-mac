<UserControl x:Class="mAIkey.Desktop.Views.PromptTemplatesView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Bg1}">

  <UserControl.Styles>
    <Style Selector="Border.TplCard">
      <Setter Property="Background" Value="{DynamicResource Bg2}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style Selector="TextBlock.TplTitle">
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style Selector="TextBlock.TplDesc">
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="760" Name="RootPanel" Margin="36,32,36,40">
      <TextBlock Name="PageEyebrow" Text="PROMPTS" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource Text3}" Margin="0,0,0,6"/>
      <TextBlock Name="PageTitle" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Text1}" Margin="0,0,0,4"/>
      <TextBlock Name="PageSubtitle" FontSize="13" Foreground="{DynamicResource Text3}" Margin="0,0,0,28"/>

      <TextBlock Name="CodeLabel" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" Margin="0,0,0,8"/>
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
        <TextBox Name="CodeBox" Height="40" Padding="12,0" FontSize="13" Background="{DynamicResource Bg2}"
                 VerticalContentAlignment="Center" KeyDown="CodeBox_KeyDown"/>
        <Button Name="AddByCodeBtn" Grid.Column="1" Classes="GhostButton" Height="40" Margin="10,0,0,0"
                Padding="18,0" FontSize="13" VerticalContentAlignment="Center" Click="AddByCodeBtn_Click"/>
      </Grid>

      <TextBlock Name="SearchLabel" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" Margin="0,0,0,8"/>
      <TextBox Name="SearchBox" Height="40" Padding="12,0" FontSize="13" Background="{DynamicResource Bg2}"
               VerticalContentAlignment="Center" Margin="0,0,0,24" TextChanged="SearchBox_TextChanged"/>

      <StackPanel Name="TemplatesContainer"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
