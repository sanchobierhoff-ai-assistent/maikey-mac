<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mAIkey.Desktop.Views.IntegrationsView"
             Background="{DynamicResource Bg1}">

  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="32,28,32,40">
    <StackPanel>

      <Grid Margin="0,0,0,24">
        <StackPanel Spacing="4" HorizontalAlignment="Left">
          <TextBlock Classes="eyebrow" Text="INTEGRATIES"/>
          <TextBlock Classes="title" Text="Verbind externe services"/>
          <TextBlock Classes="subtitle"
                     Text="Koppel tools die je dagelijks gebruikt aan je AI-hotkeys."/>
        </StackPanel>
        <Button Classes="ghost" Content="+ Integratie aanvragen"
                HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" Padding="14,8"/>
      </Grid>

      <TextBlock Name="StatusText" Classes="muted" Text="Status laden..." Margin="0,0,0,12"/>

      <!-- Raster met integratie-kaarten -->
      <WrapPanel Name="IntegrationsPanel"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
