<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:loc="using:mAIkey.Desktop"
             x:Class="mAIkey.Desktop.Views.AssistantSettingsView"
             Background="{DynamicResource Bg1}">

  <UserControl.Styles>
    <Style Selector="Border.card2">
      <Setter Property="Background" Value="{DynamicResource Bg2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style Selector="Border.card2-head">
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBlock.card2-title">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style Selector="TextBlock.field-desc">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,48" MaxWidth="820">

      <!-- Header -->
      <StackPanel Spacing="4" Margin="0,0,0,24">
        <TextBlock Classes="eyebrow" loc:Tr.Key="Assistant_Eyebrow"/>
        <TextBlock Classes="title" loc:Tr.Key="Assistant_Title"/>
        <TextBlock loc:Tr.Key="Assistant_Subtitle"
                   FontSize="13" Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
      </StackPanel>

      <!-- Assistent & sneltoetsen -->
      <Border Classes="card2">
        <StackPanel>
          <Border Classes="card2-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-robot-outline" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="card2-title" loc:Tr.Key="Assistant_CardShortcuts"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="20,16,20,20" Spacing="4">
            <CheckBox Name="AssistantEnabledCheck" loc:Tr.Key="Assistant_Enable" FontSize="13"/>
            <TextBlock Classes="field-desc" loc:Tr.Key="Assistant_EnableSub" Margin="26,0,0,14"/>

            <TextBlock loc:Tr.Key="Assistant_HotkeyLabel" FontSize="12.5" FontWeight="Medium"
                       Foreground="{DynamicResource Text1}" Margin="0,0,0,4"/>
            <TextBox Name="AssistantHotkeyBox" IsReadOnly="True" Cursor="Hand"
                     Width="240" HorizontalAlignment="Left" FontSize="13"
                     Watermark="Ctrl + Alt + Space" KeyDown="AssistantHotkey_KeyDown"/>
            <TextBlock Classes="field-desc" loc:Tr.Key="Assistant_HotkeyHint" Margin="0,4,0,14"/>

            <CheckBox Name="ScreenshotEnabledCheck" loc:Tr.Key="Assistant_ScreenshotEnable" FontSize="13"/>
            <TextBlock Classes="field-desc" loc:Tr.Key="Assistant_ScreenshotSub" Margin="26,0,0,10"/>
            <TextBlock loc:Tr.Key="Assistant_ScreenshotLabel" FontSize="12.5" FontWeight="Medium"
                       Foreground="{DynamicResource Text1}" Margin="0,0,0,4"/>
            <TextBox Name="ScreenshotHotkeyBox" IsReadOnly="True" Cursor="Hand"
                     Width="240" HorizontalAlignment="Left" FontSize="13"
                     Watermark="Ctrl + Shift + Space" KeyDown="ScreenshotHotkey_KeyDown"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Achtergrondinformatie -->
      <Border Classes="card2">
        <StackPanel>
          <Border Classes="card2-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-account" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="card2-title" loc:Tr.Key="Assistant_CardBackground"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="20,16,20,20">
            <TextBlock Classes="field-desc" loc:Tr.Key="Assistant_BackgroundDesc" Margin="0,0,0,14"/>

            <TextBlock Classes="field-label" loc:Tr.Key="Assistant_Company"/>
            <TextBox Name="CompanyBox" FontSize="13" Margin="0,0,0,12"/>

            <TextBlock Classes="field-label" loc:Tr.Key="Assistant_Role"/>
            <TextBox Name="RoleBox" FontSize="13" Margin="0,0,0,12"/>

            <TextBlock Classes="field-label" loc:Tr.Key="Assistant_About"/>
            <TextBox Name="BackgroundBox" FontSize="13" TextWrapping="Wrap"
                     AcceptsReturn="True" MinHeight="90" VerticalContentAlignment="Top"
                     Margin="0,0,0,14"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
              <TextBlock Name="BackgroundSavedLabel" Text="" VerticalAlignment="Center"
                         FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
              <Button Classes="accent" loc:Tr.Key="Assistant_Save" Padding="20,8"
                      Click="SaveBackground_Click"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Geheugen -->
      <Border Classes="card2">
        <StackPanel>
          <Border Classes="card2-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-creation" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="card2-title" loc:Tr.Key="Assistant_CardMemory"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="20,16,20,20">
            <TextBlock Classes="field-desc" loc:Tr.Key="Assistant_MemoryDesc" Margin="0,0,0,12"/>

            <StackPanel Name="MemoryPanel" Spacing="6" Margin="0,0,0,10"/>
            <TextBlock Name="MemoryEmpty" Text="—" IsVisible="False"
                       FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,0,0,10"/>

            <Grid ColumnDefinitions="*,Auto">
              <TextBox Name="MemoryAddBox" Grid.Column="0" FontSize="12.5"
                       loc:Tr.WatermarkKey="Assistant_MemoryAdd"
                       Margin="0,0,8,0"/>
              <Button Grid.Column="1" Classes="ghost" loc:Tr.Key="Assistant_AddBtn"
                      Click="AddMemory_Click"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
