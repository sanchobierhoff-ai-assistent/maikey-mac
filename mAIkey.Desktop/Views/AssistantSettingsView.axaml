<UserControl x:Class="mAIkey.Desktop.Views.AssistantSettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             Background="{DynamicResource Bg1}">


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,48">

            <!-- Page header -->
            <TextBlock x:Name="PageEyebrow" Text="MAI ASSISTENT"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text3}" Margin="0,0,0,6"/>
            <TextBlock x:Name="PageTitle" Text="mAI Assistent"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text1}" Margin="0,0,0,4"/>
            <TextBlock x:Name="PageSubtitle" Text="Beheer je assistent, sneltoetsen en achtergrondinformatie."
                       FontSize="13" Foreground="{DynamicResource Text3}" Margin="0,0,0,28"/>

            <!-- ============================================================ -->
            <!-- KAART: Assistent aan/uit + sneltoetsen                        -->
            <!-- ============================================================ -->
            <Border Margin="0,0,0,16" Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-robot-outline" FontSize="16"
                                                     Margin="0,0,9,0" Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardAssistantHeader" Text="Assistent &amp; sneltoetsen"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,16,20,20">
                        <CheckBox x:Name="AssistantEnabledCheck" Content="Assistent inschakelen"
                                  Foreground="{DynamicResource Text1}"
                                  IsCheckedChanged="AssistantEnabled_Changed"/>
                        <TextBlock x:Name="AssistantEnabledDesc"
                                   Text="Zet de assistent-sneltoetsen aan of uit."
                                   FontSize="12" Foreground="{DynamicResource Text3}"
                                   Margin="26,2,0,16" TextWrapping="Wrap"/>

                        <!-- Assistent-sneltoets -->
                        <TextBlock x:Name="AssistantHotkeyLabel" Text="Sneltoets — assistent openen"
                                   FontSize="12.5" FontWeight="Medium"
                                   Foreground="{DynamicResource Text1}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AssistantHotkeyBox" IsReadOnly="True" Cursor="Hand"
                                 Width="240" HorizontalAlignment="Left"
                                 Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text1}"
                                 BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                                 FontSize="13" Padding="10,8" Margin="0,0,0,4"
/>
                        <TextBlock x:Name="AssistantHotkeyHint"
                                   Text="Klik op het veld en druk de gewenste toetscombinatie."
                                   FontSize="11" Foreground="{DynamicResource Text3}" Margin="0,0,0,16"/>

                        <!-- Screenshot-sneltoets -->
                        <CheckBox x:Name="ScreenshotEnabledCheck" Content="Screenshot-sneltoets inschakelen"
                                  Foreground="{DynamicResource Text1}"
                                  IsCheckedChanged="ScreenshotEnabled_Changed"/>
                        <TextBlock x:Name="ScreenshotEnabledDesc"
                                   Text="Maak een schermopname die automatisch aan het gesprek wordt toegevoegd."
                                   FontSize="12" Foreground="{DynamicResource Text3}"
                                   Margin="26,2,0,8" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ScreenshotHotkeyLabel" Text="Sneltoets — screenshot"
                                   FontSize="12.5" FontWeight="Medium"
                                   Foreground="{DynamicResource Text1}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ScreenshotHotkeyBox" IsReadOnly="True" Cursor="Hand"
                                 Width="240" HorizontalAlignment="Left"
                                 Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text1}"
                                 BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                                 FontSize="13" Padding="10,8"
/>

                        <!-- AI-model voor de assistent -->
                        <TextBlock Text="AI-model voor de assistent" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{DynamicResource Text1}" Margin="0,18,0,4"/>
                        <ComboBox x:Name="AssistantModelCombo" Classes="ModernComboBox"
                                  Width="320" HorizontalAlignment="Left" Height="36"
                                  SelectionChanged="AssistantModel_Changed"/>
                        <TextBlock Text="Kies zelf welk model de assistent gebruikt. 'Automatisch' laat mAIkey een snel, goedkoop model kiezen."
                                   FontSize="11" Foreground="{DynamicResource Text3}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- KAART: Achtergrondinformatie                                  -->
            <!-- ============================================================ -->
            <Border Margin="0,0,0,16" Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-account" FontSize="16"
                                                     Margin="0,0,9,0" Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardBackgroundHeader" Text="Achtergrondinformatie"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,16,20,20">
                        <TextBlock x:Name="BackgroundDesc"
                                   Text="De assistent neemt deze informatie mee in elk gesprek."
                                   FontSize="12" Foreground="{DynamicResource Text3}"
                                   Margin="0,0,0,14" TextWrapping="Wrap"/>

                        <TextBlock x:Name="CompanyLabel" Text="Bedrijf / organisatie"
                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,0,0,4"/>
                        <TextBox x:Name="CompanyBox"
                                 Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text1}"
                                 CaretBrush="{DynamicResource Text1}"
                                 BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                                 FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock x:Name="RoleLabel" Text="Jouw rol / functie"
                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RoleBox"
                                 Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text1}"
                                 CaretBrush="{DynamicResource Text1}"
                                 BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                                 FontSize="13" Padding="10,8" Margin="0,0,0,12"/>

                        <TextBlock x:Name="BackgroundLabel" Text="Over jou / achtergrond"
                                   FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,0,0,4"/>
                        <TextBox x:Name="BackgroundBox"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text1}"
                                 CaretBrush="{DynamicResource Text1}"
                                 BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                                 FontSize="13" Padding="10,8" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="BackgroundSavedLabel" Text="" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,12,0"/>
                            <Button x:Name="SaveBackgroundBtn" Content="Opslaan" Height="36" Padding="20,0"
                                    Click="SaveBackground_Click" Classes="AccentButton"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- KAART: Geheugen                                               -->
            <!-- ============================================================ -->
            <Border Margin="0,0,0,16" Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-creation" FontSize="16"
                                                     Margin="0,0,9,0" Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="MemoryTitle" Text="Wat de assistent over je weet"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,16,20,20">
                        <TextBlock x:Name="MemoryDesc"
                                   Text="De assistent onthoudt deze feiten en gebruikt ze in gesprekken."
                                   FontSize="12" Foreground="{DynamicResource Text3}"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <ItemsControl x:Name="MemoryList" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Bg1}" CornerRadius="8"
                                            BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Content}"
                                                       Foreground="{DynamicResource Text1}" FontSize="12.5"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="&#10005;" Tag="{Binding Id}"
                                                    Width="24" Height="24" Padding="0" FontSize="11"
                                                    Click="DeleteMemory_Click"
                                                    Classes="GhostButton"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="MemoryEmpty" Text="Nog niets onthouden."
                                   FontSize="12" Foreground="{DynamicResource Text3}"
                                   Margin="0,0,0,10" IsVisible="False"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MemoryAddBox" Grid.Column="0"
                                     Background="{DynamicResource Bg1}" Foreground="{DynamicResource Text1}"
                                     CaretBrush="{DynamicResource Text1}"
                                     BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                                     FontSize="12.5" Padding="10,8" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" x:Name="MemoryAddBtn" Content="Toevoegen"
                                    Height="34" Padding="16,0" Click="AddMemory_Click"
                                    Classes="MkSecondaryButton"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
