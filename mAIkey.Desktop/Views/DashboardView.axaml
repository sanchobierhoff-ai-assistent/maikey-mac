<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="mAIkey.Desktop.Views.DashboardView">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,8,28,28" Spacing="24">

      <!-- ═══ HEADER ═══ -->
      <Grid Margin="0,0,0,4">
        <TextBlock Text="Dashboard" FontSize="15" FontWeight="Medium"
                   Foreground="{DynamicResource Text2}"
                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
        <Button Classes="accent" Content="+ Nieuwe mAIkey" Name="NewHotkeyBtn"
                HorizontalAlignment="Right" Padding="18,9" FontSize="12"/>
      </Grid>

      <!-- ═══ STAT CARDS ═══ -->
      <Grid ColumnDefinitions="*,*,*,*" Margin="0,4,0,0">
        <Grid.Styles>
          <Style Selector="Border.stat-card">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
          </Style>
        </Grid.Styles>

        <!-- Hotkeys -->
        <Border Grid.Column="0" Classes="stat-card"
                Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border1}" BorderThickness="1">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Background="#1E3A5F" CornerRadius="6" Padding="5">
                <i:Icon Value="mdi-lightning-bolt" FontSize="12" Foreground="#60A5FA"/>
              </Border>
              <TextBlock Text="mAIkeys" FontSize="11" Foreground="{DynamicResource Text2}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Name="HotkeyCountText" Text="0" FontSize="28" FontWeight="Bold"
                       Foreground="#60A5FA"/>
            <TextBlock Text="actief" FontSize="11" Foreground="{DynamicResource Text3}"/>
          </StackPanel>
        </Border>

        <!-- Vandaag -->
        <Border Grid.Column="1" Classes="stat-card"
                Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border1}" BorderThickness="1">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Background="#1E3F3A" CornerRadius="6" Padding="5">
                <i:Icon Value="mdi-chart-line" FontSize="12" Foreground="#10B981"/>
              </Border>
              <TextBlock Text="Vandaag" FontSize="11" Foreground="{DynamicResource Text2}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Name="TodayCountText" Text="0" FontSize="28" FontWeight="Bold"
                       Foreground="#10B981"/>
            <TextBlock Text="verzoeken" FontSize="11" Foreground="{DynamicResource Text3}"/>
          </StackPanel>
        </Border>

        <!-- Stijlen -->
        <Border Grid.Column="2" Classes="stat-card"
                Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border1}" BorderThickness="1">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Background="#2D1E5F" CornerRadius="6" Padding="5">
                <i:Icon Value="mdi-feather" FontSize="12" Foreground="#A78BFA"/>
              </Border>
              <TextBlock Text="Stijlen" FontSize="11" Foreground="{DynamicResource Text2}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Name="StyleCountText" Text="0" FontSize="28" FontWeight="Bold"
                       Foreground="#A78BFA"/>
            <TextBlock Text="opgeslagen" FontSize="11" Foreground="{DynamicResource Text3}"/>
          </StackPanel>
        </Border>

        <!-- Abonnement -->
        <Border Grid.Column="3" Classes="stat-card"
                Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                Margin="0">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Background="#3F3A1E" CornerRadius="6" Padding="5">
                <i:Icon Value="mdi-crown-outline" FontSize="12" Foreground="#F5A524"/>
              </Border>
              <TextBlock Text="Abonnement" FontSize="11" Foreground="{DynamicResource Text2}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Name="TierText" Text="Free" FontSize="28" FontWeight="Bold"
                       Foreground="#F5A524"/>
            <TextBlock Name="UsageText" Text="0 / 0 verzoeken" FontSize="11"
                       Foreground="{DynamicResource Text3}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ═══ MAIN CONTENT (2 columns) ═══ -->
      <Grid ColumnDefinitions="*,280">

        <!-- Left: Hotkeys list -->
        <Border Grid.Column="0" Classes="card" Margin="0,0,16,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
              <TextBlock Text="Jouw mAIkeys" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text1}"/>
              <Separator Background="{DynamicResource Border1}" Height="1" Margin="0"/>
            </StackPanel>

            <!-- Hotkey items -->
            <StackPanel Name="HotkeyListPanel" Spacing="2">
              <!-- Empty state -->
              <Border Name="EmptyHotkeyState" Padding="24"
                      HorizontalAlignment="Center">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                  <i:Icon Value="mdi-lightning-bolt" FontSize="32" HorizontalAlignment="Center"
                          Foreground="{DynamicResource Text3}"/>
                  <TextBlock Text="Nog geen hotkeys" FontSize="14"
                             Foreground="{DynamicResource Text2}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Maak je eerste AI-sneltoets aan"
                             FontSize="12" Foreground="{DynamicResource Text3}"
                             HorizontalAlignment="Center"/>
                  <Button Classes="accent" Content="+ Eerste hotkey maken"
                          HorizontalAlignment="Center" Padding="16,8"
                          FontSize="12" Name="FirstHotkeyBtn"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Right: Plan + Tips -->
        <StackPanel Grid.Column="1" Spacing="12">

          <!-- Usage warning (hidden by default) -->
          <Border Name="UsageWarningCard" IsVisible="False"
                  Background="#1F1A10" BorderBrush="#F5A52459"
                  BorderThickness="1" CornerRadius="14" Padding="16">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <i:Icon Value="mdi-alert" FontSize="12" Foreground="#F5A524" VerticalAlignment="Center"/>
                <TextBlock Text="Limiet bijna bereikt" FontSize="12"
                           FontWeight="SemiBold" Foreground="#F5A524" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Name="UsageWarningText"
                         Text="Je hebt 80% van je maandlimiet gebruikt."
                         FontSize="11" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
              <Button Classes="accent" Content="Upgrade plan"
                      FontSize="11" Padding="12,6" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <!-- Nieuws & tips -->
          <Border Classes="card">
            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <i:Icon Value="mdi-bullhorn" FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Nieuws &amp; tips" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
              </StackPanel>

              <StackPanel Spacing="4">
                <Grid>
                  <Border Background="#F5A52422" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                    <TextBlock Text="NIEUW" FontSize="9" FontWeight="Bold" Foreground="#F5A524"/>
                  </Border>
                  <TextBlock Text="2 maanden geleden" FontSize="10" Foreground="{DynamicResource Text3}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Multimodal: stuur afbeeldingen mee" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text1}" Margin="0,2,0,0"/>
                <TextBlock Text="Selecteer tekst + screenshot, mAIkey leest beide."
                           FontSize="11" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
              </StackPanel>

              <Separator Background="{DynamicResource Border1}" Height="1" Margin="0"/>

              <StackPanel Spacing="4">
                <Grid>
                  <Border Background="#F5A52422" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                    <TextBlock Text="TIP" FontSize="9" FontWeight="Bold" Foreground="#F5A524"/>
                  </Border>
                  <TextBlock Text="3 maanden geleden" FontSize="10" Foreground="{DynamicResource Text3}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="Sneller wisselen tussen mAIkeys" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text1}" Margin="0,2,0,0"/>
                <TextBlock Text="Gebruik Ctrl+Shift+Space om te zoeken zonder muis."
                           FontSize="11" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
              </StackPanel>

              <Separator Background="{DynamicResource Border1}" Height="1" Margin="0"/>

              <StackPanel Spacing="4">
                <Grid>
                  <Border Background="#10B98122" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                    <TextBlock Text="UPDATE" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                  </Border>
                  <TextBlock Text="3 maanden geleden" FontSize="10" Foreground="{DynamicResource Text3}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="GPT-4o nu sneller in alle plannen" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text1}" Margin="0,2,0,0"/>
                <TextBlock Text="Responstijden gehalveerd voor korte teksten."
                           FontSize="11" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
