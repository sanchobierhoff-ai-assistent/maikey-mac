<UserControl x:Class="mAIkey.Desktop.Views.CloudSyncView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             Background="{DynamicResource Bg1}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,32,36,40" MaxWidth="760">

            <!-- Page header -->
            <TextBlock Text="CLOUD"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text3}"
                       Margin="0,0,0,6"
                       Opacity="0.85"/>
            <TextBlock x:Name="CloudSyncTitle" Text="Cloud sync"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text1}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="CloudSyncSubtitle" Text="Exporteer je hotkeys en stijlen naar de cloud. Importeer ze op een ander apparaat of smartphone."
                       FontSize="13" Foreground="{DynamicResource Text3}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,28"/>

            <!-- ============================= -->
            <!-- KAART 1: EXPORTEREN           -->
            <!-- ============================= -->
            <Border Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel>
                    <!-- Kaart header -->
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-cloud-upload-outline" FontSize="18"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExportCardHeader" Text="Exporteren naar cloud"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,16,20,20">

                        <!-- Vorige export info -->
                        <Border x:Name="PreviousExportBorder"
                                Background="{DynamicResource Bg3}"
                                CornerRadius="8" Padding="12,10"
                                Margin="0,0,0,16"
                                IsVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon Value="mdi-information-outline" FontSize="14"
                                                         Foreground="{DynamicResource Text3}"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="PreviousExportText"
                                           FontSize="12" Foreground="{DynamicResource Text3}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Sectie: Hotkeys -->
                        <TextBlock x:Name="ExportHotkeysLabel" Text="Hotkeys"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2}"
                                   Margin="0,0,0,8"/>

                        <StackPanel x:Name="ExportHotkeysPanel" Margin="0,0,0,16"/>

                        <!-- Sectie: Stijlen -->
                        <TextBlock x:Name="ExportStylesLabel" Text="Schrijfstijlen"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text2}"
                                   Margin="0,0,0,8"/>

                        <StackPanel x:Name="ExportStylesPanel" Margin="0,0,0,16"/>

                        <!-- Niets om te exporteren -->
                        <Border x:Name="ExportEmptyState"
                                Background="{DynamicResource Bg3}" CornerRadius="8"
                                Padding="16" IsVisible="False">
                            <TextBlock x:Name="ExportEmptyText" Text="Er zijn nog geen hotkeys of stijlen aangemaakt."
                                       FontSize="12.5" Foreground="{DynamicResource Text3}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Acties -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SelectAllExportBtn" Content="Alles selecteren"
                                    Click="SelectAllExport_Click"
                                    Height="32" Padding="12,0"
                                    Margin="0,0,8,0"
                                    Classes="GhostButton"/>
                            <Button Content="Exporteer naar cloud"
                                    Click="ExportToCloud_Click"
                                    x:Name="ExportButton"
                                    Height="32" Padding="14,0"
                                    Classes="AccentButton"/>
                        </StackPanel>

                        <!-- Export status -->
                        <TextBlock x:Name="ExportStatusText"
                                   FontSize="12" Margin="0,10,0,0"
                                   HorizontalAlignment="Right"
                                   IsVisible="False"/>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================= -->
            <!-- KAART 2: IMPORTEREN           -->
            <!-- ============================= -->
            <Border Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                <StackPanel>
                    <!-- Kaart header -->
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-cloud-download-outline" FontSize="18"
                                                     Margin="0,0,10,0"
                                                     Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ImportCardHeader" Text="Importeren vanuit cloud"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,16,20,20">

                        <!-- Controleer knop (initieel zichtbaar) -->
                        <StackPanel x:Name="ImportInitialPanel">
                            <TextBlock x:Name="ImportCheckHint" Text="Controleer of er een cloudexport beschikbaar is voor dit account."
                                       FontSize="12.5" Foreground="{DynamicResource Text3}"
                                       Margin="0,0,0,14"/>
                            <Button x:Name="CheckExportBtn" Content="Controleer beschikbare export"
                                    Click="CheckExport_Click"
                                    Height="36" Padding="14,0"
                                    HorizontalAlignment="Left"
                                    Classes="GhostButton"/>
                        </StackPanel>

                        <!-- Geen export gevonden -->
                        <Border x:Name="ImportNotFoundPanel"
                                Background="{DynamicResource Bg3}" CornerRadius="8"
                                Padding="16" IsVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon Value="mdi-cloud-off-outline" FontSize="15"
                                                         Foreground="{DynamicResource Text3}"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="ImportNotFoundText" Text="Geen cloudexport gevonden voor dit account. Exporteer eerst vanuit de PC-app of smartphone."
                                           FontSize="12.5" Foreground="{DynamicResource Text3}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Export gevonden -->
                        <StackPanel x:Name="ImportFoundPanel" IsVisible="False">

                            <!-- Export info -->
                            <Border Background="{DynamicResource Bg3}"
                                    CornerRadius="8" Padding="12,10"
                                    Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <i:Icon Value="mdi-check-circle-outline" FontSize="14"
                                                             Foreground="{DynamicResource Accent}"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ImportExportInfoText"
                                               FontSize="12" Foreground="{DynamicResource Text2}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Sectie: Hotkeys -->
                            <TextBlock x:Name="ImportHotkeysLabel" Text="Hotkeys om te importeren"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2}"
                                       Margin="0,0,0,8"/>

                            <StackPanel x:Name="ImportHotkeysPanel" Margin="0,0,0,16"/>

                            <!-- Sectie: Stijlen -->
                            <TextBlock x:Name="ImportStylesLabel"
                                       Text="Schrijfstijlen om te importeren"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text2}"
                                       Margin="0,0,0,8"/>

                            <StackPanel x:Name="ImportStylesPanel" Margin="0,0,0,16"/>

                            <!-- Acties -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SelectAllImportBtn" Content="Alles selecteren"
                                        Click="SelectAllImport_Click"
                                        Height="32" Padding="12,0"
                                        Margin="0,0,8,0"
                                        Classes="GhostButton"/>
                                <Button Content="Importeer geselecteerde"
                                        Click="ImportSelected_Click"
                                        x:Name="ImportButton"
                                        Height="32" Padding="14,0"
                                        Classes="AccentButton"/>
                            </StackPanel>

                            <!-- Import status -->
                            <TextBlock x:Name="ImportStatusText"
                                       FontSize="12" Margin="0,10,0,0"
                                       HorizontalAlignment="Right"
                                       IsVisible="False"/>

                        </StackPanel>

                        <!-- Laden indicator -->
                        <StackPanel x:Name="ImportLoadingPanel"
                                    Orientation="Horizontal"
                                    IsVisible="False"
                                    Margin="0,8,0,0">
                            <i:Icon Value="mdi-loading" FontSize="16"
                                                     Foreground="{DynamicResource Text3}"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ImportLoadingText" Text="Even wachten..."
                                       FontSize="12.5" Foreground="{DynamicResource Text3}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
