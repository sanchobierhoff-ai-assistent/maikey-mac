<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:loc="using:mAIkey.Desktop"
             x:Class="mAIkey.Desktop.Views.CloudSyncView"
             Background="{DynamicResource Bg1}">

  <UserControl.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource Bg2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style Selector="Border.section-head">
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="32,28,32,40">
    <StackPanel MaxWidth="760">

      <StackPanel Spacing="4" Margin="0,0,0,24">
        <TextBlock Classes="title" loc:Tr.Key="CloudSync_Title"/>
        <TextBlock Classes="subtitle" loc:Tr.Key="CloudSync_Subtitle"/>
      </StackPanel>

      <!-- Exporteren -->
      <Border Classes="section">
        <StackPanel>
          <Border Classes="section-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-cloud-upload-outline" FontSize="17" Foreground="{DynamicResource Accent}"
                      Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock loc:Tr.Key="CloudSync_ExportHeader" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <StackPanel Margin="20,16,20,20" Spacing="14">

            <Border Background="{DynamicResource Bg3}" CornerRadius="8" Padding="12,10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <i:Icon Value="mdi-information-outline" FontSize="13" Foreground="{DynamicResource Text3}" VerticalAlignment="Center"/>
                <TextBlock Name="LastExportText" Text="Nog niet geëxporteerd." FontSize="12"
                           Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <StackPanel Spacing="6">
              <TextBlock loc:Tr.Key="CloudSync_HotkeysLabel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2}"/>
              <StackPanel Name="HotkeysPanel" Spacing="4"/>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock loc:Tr.Key="CloudSync_StylesLabel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text2}"/>
              <StackPanel Name="StylesPanel" Spacing="4"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Name="SelectAllBtn" Classes="ghost" loc:Tr.Key="CloudSync_SelectAll" Click="SelectAll_Click"/>
              <Button Name="SyncBtn" Classes="accent" loc:Tr.Key="CloudSync_ExportBtn" Click="Sync_Click"/>
            </StackPanel>

            <TextBlock Name="StatusText" Classes="muted" IsVisible="False" HorizontalAlignment="Right"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Importeren -->
      <Border Classes="section">
        <StackPanel>
          <Border Classes="section-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-cloud-download-outline" FontSize="17" Foreground="{DynamicResource Accent}"
                      Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock loc:Tr.Key="CloudSync_ImportHeader" FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="20,16,20,20" Spacing="12">
            <TextBlock Classes="muted" loc:Tr.Key="CloudSync_ImportCheckHint"/>
            <Button Name="ImportCheckBtn" Classes="ghost" loc:Tr.Key="CloudSync_CheckBtn"
                    HorizontalAlignment="Left" Click="ImportCheck_Click"/>
            <TextBlock Name="ImportStatusText" Classes="muted" IsVisible="False"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
