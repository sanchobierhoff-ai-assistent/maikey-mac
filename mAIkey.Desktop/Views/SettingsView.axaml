<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:loc="using:mAIkey.Desktop"
             x:Class="mAIkey.Desktop.Views.SettingsView"
             Background="{DynamicResource Bg1}">

  <UserControl.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource Bg2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style Selector="Border.section-head">
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border1}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.row-label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource Text1}"/>
    </Style>
    <Style Selector="TextBlock.row-sub">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="32,28,32,40">
    <StackPanel MaxWidth="760">

      <!-- Header -->
      <StackPanel Spacing="4" Margin="0,0,0,24">
        <TextBlock Classes="eyebrow" loc:Tr.Key="Settings_Title"/>
        <TextBlock Classes="title" loc:Tr.Key="Settings_Heading"/>
        <TextBlock loc:Tr.Key="Settings_Subtitle" FontSize="13"
                   Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
      </StackPanel>

      <!-- Thema -->
      <Border Classes="section">
        <StackPanel>
          <Border Classes="section-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-theme-light-dark" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="section-title" loc:Tr.Key="Settings_Card_Theme"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="20,16,20,20" Spacing="24">
            <RadioButton Name="ThemeDarkRadio" loc:Tr.Key="Settings_Theme_Dark" GroupName="ThemeGroup"/>
            <RadioButton Name="ThemeLightRadio" loc:Tr.Key="Settings_Theme_Light" GroupName="ThemeGroup"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 2 kolommen: Gedrag | Taal -->
      <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,16">

        <Border Grid.Column="0" Classes="section" Margin="0">
          <StackPanel>
            <Border Classes="section-head">
              <StackPanel Orientation="Horizontal">
                <i:Icon Value="mdi-tune-variant" FontSize="16" Foreground="{DynamicResource Accent}"
                        Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock Classes="section-title" loc:Tr.Key="Settings_Card_Behavior"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="20,16,20,20" Spacing="16">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="row-label" loc:Tr.Key="Settings_ShowIndicator"/>
                  <TextBlock Classes="row-sub" loc:Tr.Key="Settings_ShowIndicatorSub"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Name="ShowIndicatorCheck" VerticalAlignment="Center"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Classes="row-label" loc:Tr.Key="Settings_Sound"/>
                  <TextBlock Classes="row-sub" loc:Tr.Key="Settings_SoundSub"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Name="SoundCheck" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Classes="section" Margin="0">
          <StackPanel>
            <Border Classes="section-head">
              <StackPanel Orientation="Horizontal">
                <i:Icon Value="mdi-translate" FontSize="16" Foreground="{DynamicResource Accent}"
                        Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock Classes="section-title" loc:Tr.Key="Settings_Card_Lang"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="20,16,20,20" Spacing="6">
              <TextBlock Classes="row-label" loc:Tr.Key="Settings_LangInterface"/>
              <TextBlock Classes="row-sub" loc:Tr.Key="Settings_LangSubtitle"/>
              <ComboBox Name="LanguageComboBox" HorizontalAlignment="Stretch" FontSize="13" Margin="0,6,0,0">
                <ComboBoxItem Content="Nederlands" Tag="nl"/>
                <ComboBoxItem Content="English" Tag="en"/>
                <ComboBoxItem Content="Deutsch" Tag="de"/>
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Contentlimieten -->
      <Border Classes="section">
        <StackPanel>
          <Border Classes="section-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-image-multiple" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="section-title" loc:Tr.Key="Settings_ContentLimits"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="20,16,20,20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="row-label" loc:Tr.Key="Settings_MaxImages"/>
                <TextBlock Classes="row-sub" loc:Tr.Key="Settings_MaxImagesSub"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="-" Width="32" Height="32" Classes="ghost" Padding="0"
                        HorizontalContentAlignment="Center" Name="ImgMinusBtn" Click="ImgMinus_Click"/>
                <TextBlock Name="MaxImagesText" Text="3" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" Width="30" TextAlignment="Center"/>
                <Button Content="+" Width="32" Height="32" Classes="ghost" Padding="0"
                        HorizontalContentAlignment="Center" Name="ImgPlusBtn" Click="ImgPlus_Click"/>
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Classes="row-label" loc:Tr.Key="Settings_MaxChars"/>
                <TextBlock Classes="row-sub" loc:Tr.Key="Settings_MaxCharsSub"/>
              </StackPanel>
              <TextBox Grid.Column="1" Name="MaxCharsBox" Width="120" FontSize="13" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Venster -->
      <Border Classes="section">
        <StackPanel>
          <Border Classes="section-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-dock-window" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="section-title" loc:Tr.Key="Settings_WindowCard"/>
            </StackPanel>
          </Border>
          <Grid Margin="20,16,20,20" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Classes="row-label" loc:Tr.Key="Settings_MinimizeToTray"/>
              <TextBlock Classes="row-sub" loc:Tr.Key="Settings_MinimizeToTraySub"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Name="MinimizeToTrayCheck" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Account -->
      <Border Classes="section">
        <StackPanel>
          <Border Classes="section-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-account-circle" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="section-title" Text="Account"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="20,16,20,20" Spacing="4">
            <TextBlock FontSize="12" Foreground="{DynamicResource Text2}">
              <Run Text="E-mail: "/>
              <Run Name="AccountEmailRun" Text="laden..." Foreground="{DynamicResource Text1}"/>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{DynamicResource Text2}">
              <Run Text="Abonnement: "/>
              <Run Name="AccountTierRun" Text="laden..." Foreground="#F5A524"/>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Rondleiding -->
      <Border Classes="section">
        <StackPanel>
          <Border Classes="section-head">
            <StackPanel Orientation="Horizontal">
              <i:Icon Value="mdi-map-marker-path" FontSize="16" Foreground="{DynamicResource Accent}"
                      Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock Classes="section-title" loc:Tr.Key="Settings_Card_Tour"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="20,16,20,20" Spacing="12">
            <TextBlock Classes="row-sub" loc:Tr.Key="Settings_TourSub" Margin="0,0,0,4"/>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Classes="row-label" loc:Tr.Key="Settings_Tour_Hotkey"/>
                <TextBlock Classes="row-sub" loc:Tr.Key="Settings_Tour_HotkeySub"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" loc:Tr.Key="Settings_Tour_Start" VerticalAlignment="Center"
                      Click="TourHotkey_Click"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Classes="row-label" loc:Tr.Key="Settings_Tour_Style"/>
                <TextBlock Classes="row-sub" loc:Tr.Key="Settings_Tour_StyleSub"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" loc:Tr.Key="Settings_Tour_Start" VerticalAlignment="Center"
                      Click="TourStyle_Click"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Classes="row-label" loc:Tr.Key="Settings_Tour_Template"/>
                <TextBlock Classes="row-sub" loc:Tr.Key="Settings_Tour_TemplateSub"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" loc:Tr.Key="Settings_Tour_Start" VerticalAlignment="Center"
                      Click="TourTemplate_Click"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Classes="row-label" loc:Tr.Key="Settings_Tour_Pin"/>
                <TextBlock Classes="row-sub" loc:Tr.Key="Settings_Tour_PinSub"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" loc:Tr.Key="Settings_Tour_Start" VerticalAlignment="Center"
                      Click="TourPin_Click"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="mAIkey Beta-v1.4-mac" FontSize="10" Foreground="{DynamicResource Text3}"
                 HorizontalAlignment="Center" Margin="0,8"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
