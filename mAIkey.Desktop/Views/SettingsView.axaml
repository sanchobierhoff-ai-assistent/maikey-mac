<UserControl x:Class="mAIkey.Desktop.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             Background="{DynamicResource Bg1}">


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,48">

            <!-- Page header -->
            <TextBlock x:Name="PageEyebrow" Text="INSTELLINGEN"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text3}"
                       Margin="0,0,0,6"/>
            <TextBlock x:Name="PageTitle" Text="Voorkeursinstellingen"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text1}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="PageSubtitle" Text="Pas de app naar jouw voorkeur aan."
                       FontSize="13" Foreground="{DynamicResource Text3}"
                       Margin="0,0,0,28"/>

            <!-- ============================================================ -->
            <!-- THEMA-KAART: Donker / Licht                                  -->
            <!-- ============================================================ -->
            <Border Margin="0,0,0,16"
                    Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-theme-light-dark" FontSize="16"
                                                     Margin="0,0,9,0" Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardThemeHeader" Text="Thema"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="20,16,20,20" HorizontalAlignment="Left">
                        <RadioButton x:Name="ThemeDarkRadio" Content="Donker"
                                     GroupName="ThemeGroup"
                                     IsCheckedChanged="ThemeDark_Checked"
                                     Foreground="{DynamicResource Text1}"
                                     Margin="0,0,24,0"/>
                        <RadioButton x:Name="ThemeLightRadio" Content="Licht (Linnen)"
                                     GroupName="ThemeGroup"
                                     IsCheckedChanged="ThemeLight_Checked"
                                     Foreground="{DynamicResource Text1}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================================ -->
            <!-- 2-KOLOM KAARTEN: Gedrag | Taal & model                       -->
            <!-- ============================================================ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Gedrag-kaart ── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Bg2}" CornerRadius="14"
                        BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                    <StackPanel>
                        <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon Value="mdi-monitor" FontSize="16"
                                                         Margin="0,0,9,0"
                                                         Foreground="{DynamicResource Accent}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="CardBehaviorHeader" Text="Gedrag"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="20,16,20,20">

                            <!-- Autostart bij Windows -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="AutostartLabel" Text="Autostart bij Windows"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Text1}"/>
                                    <TextBlock x:Name="AutostartSubLabel" Text="Start mAIkey automatisch bij inloggen"
                                               FontSize="11.5" Foreground="{DynamicResource Text3}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="AutostartCheckBox"
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="Autostart_Changed"/>
                            </Grid>

                            <!-- Toon AI-indicator -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="ShowIndicatorLabel" Text="Toon AI-indicator tijdens verwerking"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Text1}"/>
                                    <TextBlock x:Name="ShowIndicatorSubLabel" Text="Laat zien dat de AI bezig is"
                                               FontSize="11.5" Foreground="{DynamicResource Text3}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ShowAiIndicatorCheckBox"
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="ShowAiIndicator_Changed"/>
                            </Grid>

                            <!-- Geluid bij voltooiing -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="SoundLabel" Text="Geluid bij voltooiing"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Text1}"/>
                                    <TextBlock x:Name="SoundSubLabel" Text="Speel een geluid af als de AI klaar is"
                                               FontSize="11.5" Foreground="{DynamicResource Text3}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="SoundCheckBox"
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="Sound_Changed"/>
                            </Grid>

                            <!-- Snelkoppeling op bureaublad (alleen Windows) -->
                            <Grid Margin="0,0,0,16" IsVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="DesktopShortcutLabel" Text="Snelkoppeling op bureaublad"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Text1}"/>
                                    <TextBlock x:Name="DesktopShortcutSubLabel" Text="Plaats een mAIkey-snelkoppeling op je bureaublad"
                                               FontSize="11.5" Foreground="{DynamicResource Text3}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="DesktopShortcutCheckBox"
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="DesktopShortcut_Changed"/>
                            </Grid>

                            <!-- Snelkoppeling in Startmenu (alleen Windows) -->
                            <Grid IsVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="StartMenuShortcutLabel" Text="Snelkoppeling in Startmenu"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Text1}"/>
                                    <TextBlock x:Name="StartMenuShortcutSubLabel" Text="Toon mAIkey in het Startmenu"
                                               FontSize="11.5" Foreground="{DynamicResource Text3}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="StartMenuShortcutCheckBox"
                                          VerticalAlignment="Center"
                                          IsCheckedChanged="StartMenuShortcut_Changed"/>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- gap -->

                <!-- ── Taal & model-kaart ── -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Bg2}" CornerRadius="14"
                        BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                    <StackPanel>
                        <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon Value="mdi-translate" FontSize="16"
                                                         Margin="0,0,9,0"
                                                         Foreground="{DynamicResource Accent}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="CardLangHeader" Text="Taal"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text1}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="20,16,20,20">

                            <!-- Taal interface -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock x:Name="LangInterfaceLabel" Text="Taal interface"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource Text1}"/>
                                    <TextBlock x:Name="LangInterfaceSubLabel" Text="Taal van menu's, labels en berichten"
                                               FontSize="11.5" Foreground="{DynamicResource Text3}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Row="2"
                                          x:Name="LanguageComboBox"
                                          Classes="MkComboBox"
                                          Height="36"
                                          SelectionChanged="Language_Changed">
                                    <ComboBoxItem Content="Nederlands" Tag="nl"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="Deutsch" Tag="de"/>
                                </ComboBox>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- CONTENTLIMIETEN (bestaand, volledige breedte)                -->
            <!-- ============================================================ -->
            <Border Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-shield-outline" FontSize="16"
                                                     Margin="0,0,9,0"
                                                     Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardContentLimitsHeader" Text="Contentlimieten"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock x:Name="ContentLimitsSub" Text="Als je meer afbeeldingen of tekens verstuurt dan het ingestelde limiet, vraagt de app om bevestiging."
                                   FontSize="12.5" Foreground="{DynamicResource Text3}"
                                   TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <!-- Max Images -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="MaxImagesLabel"
                                           Text="Max. afbeeldingen"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="MaxImagesSubLabel"
                                           Text="Bevestiging vereist boven dit aantal"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="−" Width="32" Height="32"
                                        Click="DecreaseMaxImages_Click" Classes="GhostButton" Padding="0"
                                        Cursor="Hand"/>
                                <TextBlock x:Name="MaxImagesText"
                                           Width="44" TextAlignment="Center"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource Text1}"
                                           VerticalAlignment="Center"/>
                                <Button Content="+" Width="32" Height="32"
                                        Click="IncreaseMaxImages_Click" Classes="GhostButton" Padding="0"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <!-- Max Characters -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="MaxCharsLabel"
                                           Text="Max. tekens"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="MaxCharsSubLabel"
                                           Text="Bevestiging vereist boven dit aantal tekens"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="MaxCharsTextBox" Grid.Column="1"
                                     Width="90" Height="36"
                                     TextAlignment="Center"
                                     FontSize="14" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource Bg3}"
                                     Foreground="{DynamicResource Text1}"
                                     CaretBrush="{DynamicResource Accent}"
                                     BorderBrush="{DynamicResource Border1}"
                                     BorderThickness="1"
                                     LostFocus="MaxCharsTextBox_LostFocus"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Minimaliseren naar tray -->
            <Border Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-window-minimize" FontSize="16"
                                                     Margin="0,0,9,0"
                                                     Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardWindowHeader" Text="Venster"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="20,16,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="MinimizeToTrayLabel" Text="Minimaliseren naar system tray"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource Text1}"/>
                            <TextBlock x:Name="MinimizeToTraySubLabel" Text="App blijft actief in de achtergrond bij sluiten"
                                       FontSize="11.5" Foreground="{DynamicResource Text3}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="MinimizeToTrayCheckBox"
                                  VerticalAlignment="Center"
                                  IsCheckedChanged="MinimizeToTray_Changed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- macOS-toestemmingen -->
            <Border Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1"
                    Margin="0,0,0,16">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-shield-check-outline" FontSize="16"
                                    Margin="0,0,9,0"
                                    Foreground="{DynamicResource Accent}"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardPermissionsHeader" Text="macOS-toestemmingen"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="20,16,20,20">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="PermAccessibilityLabel" Text="Toegankelijkheid"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="PermAccessibilityStatus"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="PermAccessibilityBtn" Grid.Column="1" Height="32" Padding="14,0"
                                    Classes="MkSecondaryButton" Click="PermAccessibility_Click"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="PermScreenLabel" Text="Schermopname"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="PermScreenStatus"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="PermScreenBtn" Grid.Column="1" Height="32" Padding="14,0"
                                    Classes="MkSecondaryButton" Click="PermScreen_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Rondleiding -->
            <Border Background="{DynamicResource Bg2}" CornerRadius="14"
                    BorderBrush="{DynamicResource Border1}" BorderThickness="1">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="{DynamicResource Border1}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Value="mdi-map-marker-path" FontSize="16"
                                                     Margin="0,0,9,0"
                                                     Foreground="{DynamicResource Accent}"
                                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardTourHeader"
                                       Text="Rondleiding"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text1}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock x:Name="TourSubLabel"
                                   Text="Start een rondleiding opnieuw om een functie stap voor stap te leren kennen."
                                   FontSize="12.5" Foreground="{DynamicResource Text3}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <!-- mAIkeys tour -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TourHotkeyLabel"
                                           Text="mAIkeys"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="TourHotkeySubLabel"
                                           Text="Maak je eerste mAIkey en leer alle opties kennen"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="TourHotkeyStartBtn" Grid.Column="1" Content="▶  Starten"
                                    Height="32" Padding="14,0"
                                    Click="TourHotkey_Click"
                                    Classes="MkSecondaryButton"
                                    Cursor="Hand"/>
                        </Grid>

                        <!-- Stijl Library tour -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TourStyleLabel"
                                           Text="Stijl Library"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="TourStyleSubLabel"
                                           Text="Leer de AI jouw schrijfstijl aan"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="TourStyleStartBtn" Grid.Column="1" Content="▶  Starten"
                                    Height="32" Padding="14,0"
                                    Click="TourStyle_Click"
                                    Classes="MkSecondaryButton"
                                    Cursor="Hand"/>
                        </Grid>

                        <!-- Templates tour -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TourTemplateLabel"
                                           Text="Templates"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="TourTemplateSubLabel"
                                           Text="Gebruik kant-en-klare AI-acties"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="TourTemplateStartBtn" Grid.Column="1" Content="▶  Starten"
                                    Height="32" Padding="14,0"
                                    Click="TourTemplate_Click"
                                    Classes="MkSecondaryButton"
                                    Cursor="Hand"/>
                        </Grid>

                        <!-- Pin tour -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TourPinLabel"
                                           Text="App vastmaken aan taakbalk"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource Text1}"/>
                                <TextBlock x:Name="TourPinSubLabel"
                                           Text="Open mAIkey altijd met één klik"
                                           FontSize="11.5" Foreground="{DynamicResource Text3}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="TourPinStartBtn" Grid.Column="1" Content="▶  Starten"
                                    Height="32" Padding="14,0"
                                    Click="TourPin_Click"
                                    Classes="MkSecondaryButton"
                                    Cursor="Hand"/>
                        </Grid>

                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
